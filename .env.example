# Public Vite variables. For local development, copy this file to `.env`; for
# Vercel, add the same values in Project Settings → Environment Variables.
# Do not put Entra tenant URLs, Entra client secrets, or Supabase service-role
# keys in this file: browser variables are included in the shipped bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
